# Marca (todas opcionais — têm fallback genérico em lib/config.ts)
NEXT_PUBLIC_BRAND_NAME="Assessoria Alpha"
# Envolva uma palavra/número entre asteriscos pra destacar em laranja, ex: "Gaste *1 real* por lead"
NEXT_PUBLIC_BRAND_HEADLINE="A Maior Assessoria de Marketing Nichada da América Latina."
NEXT_PUBLIC_BRAND_DESCRIPTION="Uma análise estratégica para identificar oportunidades de captação de clientes para o seu consultório."
# Logo em fundo escuro/preto, usada sobre o painel laranja
NEXT_PUBLIC_BRAND_LOGO_PANEL="/logo-fundo-preto.jpg"
# Logo transparente, usada sobre fundo branco (header do form, páginas de resultado)
NEXT_PUBLIC_BRAND_LOGO_MARK="/logo-sem-fundo.PNG"
# Imagem de fundo do painel lateral — em public/brand-panel-bg.webp
# (enquanto não existir, cai no gradiente laranja definido em globals.css)
NEXT_PUBLIC_BRAND_PANEL_BG="/brand-panel-bg.webp"

# Página /obrigado (lead qualificado)
NEXT_PUBLIC_OBRIGADO_HEADLINE="Cadastro *Concluído!*"
NEXT_PUBLIC_OBRIGADO_DESCRIPTION="Nos próximos minutos, o nosso time de especialistas vai entrar em contato para entender melhor o seu consultório e como podemos ajudar a aumentar sua captação de pacientes."

# Página /agradecimento (lead desqualificado)
NEXT_PUBLIC_AGRADECIMENTO_HEADLINE="Obrigado pelo interesse!"
NEXT_PUBLIC_AGRADECIMENTO_DESCRIPTION="Analisamos cada perfil com cuidado. Se houver uma oportunidade de parceria, entraremos em contato com você em breve."
NEXT_PUBLIC_AGRADECIMENTO_CTA="Enquanto isso, acompanhe nosso conteúdo e fique por dentro das novidades."
# Redes sociais na página /agradecimento (em branco, o ícone não aparece)
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL="https://www.youtube.com/@assessorialpha"
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL="https://www.instagram.com/assessorialpha/"

# Tracking (em branco = script não é carregado)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Identificação do formulário nos eventos de tracking
NEXT_PUBLIC_FORM_NAME="diagnostico_captacao_leads"
NEXT_PUBLIC_LEAD_SOURCE="landing_page"

# Webhook do n8n que recebe o lead ao final do funil
NEXT_PUBLIC_N8N_WEBHOOK_URL=
